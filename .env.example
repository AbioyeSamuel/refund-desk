# Copy to .env and fill in ONE of the API keys. Leave both empty to run with the
# offline mock provider (keyword heuristics + templates) — everything still works.

# auto = Anthropic if its key is set, else OpenAI, else mock. Or force: anthropic | openai | mock
AI_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (Groq, Together, a local Ollama at http://host.docker.internal:11434/v1, ...)
OPENAI_BASE_URL=https://api.openai.com/v1

# Support dashboard password (sent as the x-admin-token header)
ADMIN_TOKEN=demo-admin-token
# Signs customer sessions — use a long random string outside local demos
SESSION_SECRET=local-demo-session-secret-change-in-production
# Shows demo accounts on the sign-in page and enables "Reset demo data"
DEMO_MODE=true

# Host ports
WEB_PORT=3000
API_PORT=4000
